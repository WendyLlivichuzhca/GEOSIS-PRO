<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista de Bitácora -->
    <record id="view_geosis_bitacora_tree" model="ir.ui.view">
        <field name="name">geosis.bitacora.tree</field>
        <field name="model">geosis.bitacora</field>
        <field name="arch" type="xml">
            <tree string="Libro de Obra">
                <field name="date"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="weather"/>
                <field name="content" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Vista de Formulario de Bitácora -->
    <record id="view_geosis_bitacora_form" model="ir.ui.view">
        <field name="name">geosis.bitacora.form</field>
        <field name="model">geosis.bitacora</field>
        <field name="arch" type="xml">
            <form string="Asiento de Libro de Obra">
                <header>
                    <button name="action_approve" 
                            string="Aprobar Libro de Obra" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="project_id" string="Proyecto"/>
                        <h1>
                            <field name="project_id" placeholder="Seleccione el Proyecto..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="weather" widget="selection"/>
                        </group>
                        <group string="Ubicación y GPS">
                            <label for="latitude" string="Coordenadas GPS"/>
                            <div class="o_row">
                                <span>Lat:</span> <field name="latitude"/>
                                <span>Lon:</span> <field name="longitude"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resumen y Tareas" name="content">
                            <field name="content" placeholder="Describa lo ocurrido hoy en la obra..." class="oe_memo"/>
                            <separator string="Tareas y Avances"/>
                            <field name="task_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="done"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Personal y Equipos" name="resources">
                            <group>
                                <field name="personal_notes" placeholder="Ej: 1 Residente de Obra, 4 Albañiles, 2 Peones..." class="oe_memo"/>
                                <field name="equipment_notes" placeholder="Ej: 1 Retroexcavadora CAT 320, 2 Volquetas..." class="oe_memo"/>
                            </group>
                        </page>
                        <page string="Bitácora (MIDUVI)" name="bitacora_notes">
                            <group>
                                <field name="contractor_queries" placeholder="Consultas o requerimientos realizados por el Contratista..." class="oe_memo"/>
                                <field name="inspector_instructions" placeholder="Instrucciones, disposiciones o aprobaciones emitidas por la Fiscalización..." class="oe_memo"/>
                            </group>
                        </page>
                        <page string="Fotos de Evidencia" name="photos">
                            <field name="photo_ids">
                                <kanban>
                                    <field name="id"/>
                                    <field name="caption"/>
                                    <field name="image"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click">
                                                <div class="o_kanban_image">
                                                    <img t-att-src="kanban_image('geosis.bitacora.photo', 'image', record.id.raw_value)" alt="Evidencia"/>
                                                </div>
                                                <div class="oe_kanban_details">
                                                    <strong><field name="caption"/></strong>
                                                    <div><field name="date_taken"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="image" widget="image" options="{'size': [300, 300]}"/>
                                        <field name="caption"/>
                                        <field name="date_taken"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Firmas Digitales" name="signatures">
                            <group>
                                <group string="Contratista">
                                    <field name="signature_contractor" widget="image" readonly="1" class="oe_avatar"/>
                                </group>
                                <group string="Fiscalizador">
                                    <field name="signature_inspector" widget="image" readonly="1" class="oe_avatar"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para el menú -->
    <record id="action_geosis_bitacora" model="ir.actions.act_window">
        <field name="name">Libro de Obra</field>
        <field name="res_model">geosis.bitacora</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer asiento de tu Libro de Obra.
            </p>
            <p>
                Los reportes generados desde la App móvil aparecerán aquí automáticamente.
            </p>
        </field>
    </record>

    <!-- Menú (Simplificado para evitar errores de dependencia) -->
    <menuitem id="menu_geosis_bitacora_root" 
              name="Libro de Obra" 
              parent="geosis_base.menu_geosis_root"
              action="action_geosis_bitacora" 
              sequence="25"
              groups="geosis_base.group_geosis_admin,geosis_base.group_geosis_user,geosis_base.group_geosis_readonly"/>
</odoo>
