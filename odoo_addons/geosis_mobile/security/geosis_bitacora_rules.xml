            <field name="name">GEOSIS bitacoras por cliente</field>
            <field name="model_id" ref="model_geosis_bitacora"/>
            <field name="domain_force">[('project_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
