        </record>

        <record id="group_geosis_readonly" model="res.groups">
            <field name="name">GEOSIS Consulta</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
