            <field name="name">GEOSIS Administrador</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_geosis_user" model="res.groups">
            <field name="name">GEOSIS Presupuestador</field>
            <field name="category_id" ref="base.module_category_hidden"/>
