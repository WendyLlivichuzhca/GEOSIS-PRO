<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geosis_budget_search" model="ir.ui.view">
        <field name="name">geosis.budget.search</field>
        <field name="model">geosis.budget</field>
        <field name="arch" type="xml">
            <search string="Buscar Presupuestos">
                <field name="code"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="location"/>
                <field name="budget_date"/>
                <filter name="filter_active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactivos" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Aprobado" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_archived" string="Archivado" domain="[('state', '=', 'archived')]"/>
            </search>
        </field>
    </record>

    <record id="view_geosis_budget_tree" model="ir.ui.view">
        <field name="name">geosis.budget.tree</field>
        <field name="model">geosis.budget</field>
        <field name="arch" type="xml">
            <tree string="Presupuestos">
                <field name="code"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="location"/>
                <field name="budget_date"/>
                <field name="state"/>
                <field name="subtotal_amount"/>
                <field name="total_amount"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_geosis_budget_form" model="ir.ui.view">
        <field name="name">geosis.budget.form</field>
        <field name="model">geosis.budget</field>
        <field name="arch" type="xml">
            <form string="Presupuesto">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="customer_name"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="budget_date"/>
                            <field name="state"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="subtotal_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rubros APU">
                            <field name="line_ids">
                                <tree editable="bottom" string="Detalle del presupuesto">
                                    <field name="sequence" widget="handle"/>
                                    <field name="apu_id"/>
                                    <field name="apu_code" readonly="1"/>
                                    <field name="apu_name" readonly="1"/>
                                    <field name="uom_name" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="description" placeholder="Notas del presupuesto..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geosis_budgets" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">geosis.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_geosis_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer presupuesto de GEOSIS-PRO
            </p>
            <p>
                Aqui agregas rubros APU, cantidades y subtotales para consolidar
                el presupuesto del proyecto.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_geosis_budget_items"
        name="Presupuestos"
        parent="geosis_base.menu_geosis_budgets"
        action="action_geosis_budgets"
        sequence="10"
    />
</odoo>
