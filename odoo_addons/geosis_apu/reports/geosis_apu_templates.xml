<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla reutilizable con el contenido del APU -->
    <template id="geosis_apu_content_template">
        <div class="page" style="font-family: 'Helvetica', sans-serif; font-size: 11px;">
            <!-- Encabezado del Rubro -->
            <div class="text-center mb-4">
                <h4 style="color: #1a4d8a;">ANALISIS DE PRECIOS UNITARIOS</h4>
            </div>

            <table class="table table-sm table-bordered mb-4">
                <tr style="background-color: #f2f2f2;">
                    <th width="15%">RUBRO:</th>
                    <td width="55%"><t t-esc="apu.name"/></td>
                    <th width="15%">CODIGO:</th>
                    <td width="15%"><t t-esc="apu.code"/></td>
                </tr>
                <tr>
                    <th>UNIDAD:</th>
                    <td><t t-esc="apu.uom_name"/></td>
                    <th>FECHA:</th>
                    <td><t t-esc="context_today().strftime('%d/%m/%Y')"/></td>
                </tr>
            </table>

            <!-- Secciones de Costos -->
            <t t-set="categories" t-value="[('M', 'EQUIPOS'), ('N', 'MANO DE OBRA'), ('O', 'MATERIALES'), ('P', 'TRANSPORTE')]"/>
            
            <t t-foreach="categories" t-as="cat">
                <t t-set="lines" t-value="apu.line_ids.filtered(lambda l: l.category == cat[0])"/>
                <t t-if="lines">
                    <h6 class="mt-3" style="border-bottom: 2px solid #1a4d8a; color: #1a4d8a;">
                        <t t-esc="cat[1]"/>
                    </h6>
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr style="background-color: #f9f9f9;">
                                <th width="10%">CODIGO</th>
                                <th width="45%">DESCRIPCION</th>
                                <th width="10%" class="text-right">CANTIDAD</th>
                                <th width="10%" class="text-right">TARIFA</th>
                                <th width="10%" class="text-right">REND.</th>
                                <th width="15%" class="text-right">COSTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="l">
                                <td><t t-esc="l.resource_id.code"/></td>
                                <td><t t-esc="l.resource_id.name"/></td>
                                <td class="text-right"><t t-esc="formatLang(l.quantity, digits=4)"/></td>
                                <td class="text-right"><t t-esc="formatLang(l.rate, currency_obj=apu.currency_id)"/></td>
                                <td class="text-right"><t t-esc="formatLang(l.performance, digits=4)"/></td>
                                <td class="text-right"><strong><t t-esc="formatLang(l.cost, currency_obj=apu.currency_id)"/></strong></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-right"><strong>SUBTOTAL <t t-esc="cat[1]"/>:</strong></td>
                                <td class="text-right" style="border-top: 2px solid #000;">
                                    <strong><t t-esc="formatLang(sum(lines.mapped('cost')), currency_obj=apu.currency_id)"/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </t>
            </t>

            <!-- Resumen Final -->
            <div class="row justify-content-end mt-4">
                <div class="col-6">
                    <table class="table table-sm table-bordered">
                        <tr>
                            <td width="70%"><strong>TOTAL COSTO DIRECTO (A):</strong></td>
                            <td width="30%" class="text-right"><strong><t t-esc="formatLang(apu.direct_cost, currency_obj=apu.currency_id)"/></strong></td>
                        </tr>
                        <tr>
                            <td>INDIRECTOS Y UTILIDADES (<t t-esc="apu.indirect_percent"/>%) (B):</td>
                            <td class="text-right"><t t-esc="formatLang(apu.indirect_value, currency_obj=apu.currency_id)"/></td>
                        </tr>
                        <tr style="background-color: #1a4d8a; color: white; font-size: 14px;">
                            <td><strong>PRECIO UNITARIO (A + B):</strong></td>
                            <td class="text-right"><strong><t t-esc="formatLang(apu.total_cost, currency_obj=apu.currency_id)"/></strong></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>

    <!-- Reporte principal de APU (Individual) -->
    <template id="report_geosis_apu_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="apu">
                <t t-call="web.external_layout">
                    <t t-call="geosis_apu.geosis_apu_content_template"/>
                    <div class="mt-5 pt-5 text-center">
                        <div class="row">
                            <div class="col-4 border-top mx-auto p-2">
                                ELABORADO POR
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
